# ============================================================
# SQL-Coder & Analytics Agent
# Environment Variables
# ============================================================

# LLM provider
LLM_PROVIDER=gemini

# Gemini API
GEMINI_API_KEY=

# Database
DATABASE_PATH=data/ecommerce.duckdb

# ============================================================
# CORS
# ============================================================

# Local development is automatically allowed.
#
# For production, add the public frontend URL:
#
# ALLOWED_ORIGINS=https://your-frontend.onrender.com

ALLOWED_ORIGINS=